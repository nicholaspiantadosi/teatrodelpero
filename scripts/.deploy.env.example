# Copia questo file in "scripts/.deploy.env" e compila i valori.
# NON versionare .deploy.env: contiene un token segreto.
#
# Site ID: dashboard Netlify → Site configuration → General →
#          Site information → Site ID  (è un UUID, non lo slug)
NETLIFY_SITE_ID=""
#
# Token: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=""
